host:
  rpm:
    build:
    - python3-gbulb.spec
vm:
  rpm:
    build:
    - python3-gbulb.spec
  deb:
    build:
    - debian-pkg/debian
    source:
      commands:
      - '@PLUGINS_DIR@/source_deb/scripts/debian-quilt @SOURCE_DIR@/series-debian.conf @BUILD_DIR@/debian/patches'

source:
  files:
  - git-url: https://github.com/beeware/gbulb.git
    commit-id: 51c34224974d98fb91ffc91e856c691a94b1ab45
    git-basename: gbulb-@VERSION@
